# --- CPU ---------------------------------------------------------------
# The single most important line in this file. Anything else emits NOPL
# and the board dies with an illegal instruction during early boot.
CONFIG_MGEODE_LX=y
CONFIG_X86_32=y
# 256MB of RAM, so no highmem. NOHIGHMEM is the choice member that has
# to be turned ON: "# CONFIG_HIGHMEM4G is not set" on its own just lets
# kconfig fall back to the choice default, which is HIGHMEM4G again.
CONFIG_NOHIGHMEM=y
# CONFIG_SMP is not set
# Legacy BIOS only. i386_defconfig turns EFI and the EFI stub on.
# CONFIG_EFI is not set

# --- Storage -----------------------------------------------------------
# CF card is on the CS5536 PATA channel in True IDE mode.
CONFIG_ATA=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_PATA_CS5536=y
CONFIG_PATA_AMD=y
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y

# --- Removable storage -------------------------------------------------
# Whatever someone plugs in. FAT and ext4 are already above; these two
# are what the rest of the world actually ships on a USB drive. Both are
# in-tree in 6.6 - exfat since 5.7, ntfs3 since 5.15 - so neither costs
# an out-of-tree module.
#
# ntfs3 is read-write upstream but /usr/sbin/slmp-usb-mount mounts
# everything read-only anyway, which sidesteps the question of how much
# to trust it with someone's only copy of their music.
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y

# --- Network shares ----------------------------------------------------
# SMB/CIFS, because the music lives on a NAS and MPD's own smbclient
# storage plugin is not available here: it needs libsmbclient, which in
# Buildroot means samba4, which "depends on !BR2_TOOLCHAIN_USES_MUSL".
# Switching the whole image to glibc to get an smb:// URI in myMPD's
# mount dialog is not a trade worth making, so the share is mounted by
# the kernel and MPD sees an ordinary directory under /media.
#
# CIFS selects everything it needs - NLS_UCS2_UTILS, KEYS, ASN1,
# NETFS_SUPPORT and six crypto algorithms - so this one symbol is
# enough. Verify it anyway: that is a lot of implied dependencies.
#
# CONFIG_CIFS_ALLOW_INSECURE_LEGACY is not listed here and is on anyway:
# it is "default y" in fs/smb/client/Kconfig, so selecting CIFS brings it
# in. That is harmless - it only permits SMB1 and SMB2.0 to be asked for
# explicitly with vers=1.0, and nothing does. Worth knowing rather than
# rediscovering, since the mount options are where the dialect is
# actually chosen.
CONFIG_CIFS=y
# NFS is already on from i386_defconfig. Note that NFSv3 needs a
# userspace portmapper negotiation that BusyBox's mount cannot do
# (CONFIG_FEATURE_MOUNT_NFS is off), so only NFSv4 is usable here.

# --- Audio -------------------------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
# ESI Juli@ (Envy24HT / ICE1724). The Juli@-specific quirk code lives
# inside this driver.
CONFIG_SND_ICE1724=y
# USB DAC path.
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
# i386_defconfig enables HD-audio. Nothing here has an HDA codec, but
# whichever driver registers first takes card index 0 and mpd.conf names
# the card by index. Remove the possibility.
# CONFIG_SND_HDA_INTEL is not set

# --- USB ---------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
# The CS5536 has OHCI and EHCI. Nothing else.
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_UHCI_HCD is not set

# --- Serial ------------------------------------------------------------
# The front panel link. There is deliberately no getty on it.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# --- Watchdog ----------------------------------------------------------
# CS5536 hardware watchdog. The panel daemon pets this from its main
# loop once it exists.
#
# GEODE_WDT depends on CS5535_MFGPT, which depends on MFD_CS5535. Set
# CONFIG_GEODE_WDT on its own and kconfig drops it without a word, and
# the first sign of trouble is a Phase 3 panel daemon opening
# /dev/watchdog and getting ENOENT.
CONFIG_WATCHDOG=y
CONFIG_MFD_CS5535=y
CONFIG_CS5535_MFGPT=y
CONFIG_GEODE_WDT=y

# --- Geode crypto ------------------------------------------------------
# The LX has a dedicated AES block. Not AES-NI, but far better than
# software AES on a 500MHz core.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_DEV_GEODE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_GEODE=y

# --- Networking --------------------------------------------------------
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
# lspci on a real BDP-1 says:
#   00:0d.0 Ethernet controller: VIA Technologies, Inc. VT6105M [Rhine-III]
# so the shotgun is gone and this is the one driver that matters. The
# Realtek and NatSemi drivers that used to be here were carried on the
# off chance and never bound to anything.
CONFIG_NET_VENDOR_VIA=y
CONFIG_VIA_RHINE=y
# CONFIG_NET_VENDOR_REALTEK is not set
# CONFIG_NET_VENDOR_NATSEMI is not set

# --- Trim --------------------------------------------------------------
# No DRM and no fbdev. The VGA text console has no prompt on x86 and
# stays on by default, which is all console=tty0 needs.
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND_OSS_CORE is not set
